{
  "name": "ai-workflow-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "npm run db:generate && next build",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run db:generate && next typegen && tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "node scripts/test-public.mjs",
    "check": "npm run db:validate && npm run lint && npm run typecheck && npm test",
    "agents:team:init": "node --use-env-proxy --conditions=react-server --import tsx scripts/agent-team-init.ts",
    "agents:tick": "node --use-env-proxy --conditions=react-server --import tsx scripts/agent-worker.ts",
    "test:agent-service": "node scripts/test-agent-service.mjs",
    "agents:service": "node scripts/agent-service.mjs",
    "db:validate": "node scripts/prisma-wasm.mjs validate",
    "db:generate": "node scripts/prisma-wasm.mjs generate",
    "db:deploy": "node scripts/prisma-wasm.mjs deploy",
    "db:status": "node scripts/prisma-wasm.mjs status",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "db:seed:catalog": "node --conditions=react-server --import tsx prisma/seed-catalog.ts",
    "admin:init": "node --conditions=react-server --import tsx scripts/admin-init.ts",
    "admin:password": "node --conditions=react-server --import tsx scripts/admin-init.ts --rotate",
    "db:local": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:backup": "node scripts/local-db.mjs backup",
    "db:restore-check": "node scripts/local-db.mjs restore-check",
    "test:db": "node scripts/test-db.mjs",
    "db:seed:editorial": "node --conditions=react-server --import tsx prisma/seed-editorial.ts",
    "newsletter:secret": "node scripts/newsletter-secret.mjs",
    "commercial:secret": "node scripts/commercial-secret.mjs",
    "db:seed:commercial": "node --conditions=react-server --import tsx prisma/seed-commercial.ts",
    "launch:check": "node --conditions=react-server --import tsx scripts/launch-check.ts",
    "ops:maintenance": "node --conditions=react-server --import tsx scripts/maintenance.ts",
    "catalog:validate": "node --conditions=react-server --import tsx scripts/catalog-import.ts validate",
    "catalog:research": "node --use-env-proxy scripts/catalog-research.mjs",
    "test:catalog-import": "node scripts/test-catalog-import.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@prisma/client-generator-ts": "7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@prisma/schema-engine-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
