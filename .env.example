# Example configuration only; never insert real secrets in this file.
# Absolute HTTP(S) origin only: no path, query, fragment or credentials.
# Metadata changes require a new production build.
SITE_URL=http://localhost:3000

# Explicit preview of fictional DRAFT records marked isDemo=true.
# Keep false for a public deployment; it never publishes the development seed.
CATALOG_DEMO_MODE=false

# PostgreSQL: npm run db:local can generate local-only credentials in .env.local.
# For an external database, configure the bindings securely (examples only):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/atlas_dev?sslmode=verify-full
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/atlas_test?sslmode=verify-full
# Tests create and remove their own isolated database; the test role needs CREATEDB.
# DEV_POSTGRES_PASSWORD is generated by the local helper; never commit its value.
# Administration: exact browser origin; HTTPS required except on loopback.
# Defaults to SITE_URL. Set separately when the browser origin differs.
# ADMIN_ORIGIN=http://localhost:3000
# First owner identity for the interactive operator CLI; illustrative address only.
# ADMIN_BOOTSTRAP_EMAIL=owner@example.invalid
# Passwords are entered with npm run admin:init, never configured in this file.
# Provider bindings below stay private and disabled until configuration and authorization.

# Keep false during pre-launch. Enabling also requires an explicit HTTPS SITE_URL
# on a non-loopback host and CATALOG_DEMO_MODE=false. No launch is performed here.
SEO_INDEXING_ENABLED=false

# Public sponsorship inquiry signing key, private and shared by app instances.
# Generate local-only configuration with npm run commercial:secret; never paste it here.
# SPONSOR_FORM_SECRET=YOUR_PRIVATE_64_LOWERCASE_HEX_SIGNING_KEY
# Exact browser origin for public inquiry POST; defaults to SITE_URL/localhost:3000.
# SPONSOR_ORIGIN=http://localhost:3000

# Newsletter remains local until Resend is explicitly enabled.
# Generate a private local 32-byte encryption/signing key with npm run newsletter:secret.
# Preserve this key with private database backups; never use a proxy placeholder for it.
# NEWSLETTER_SECRET=YOUR_PRIVATE_64_LOWERCASE_HEX_KEY
NEWSLETTER_MODE=disabled
# Exact public browser origin and email link origin; HTTPS except loopback.
# NEWSLETTER_ORIGIN=http://localhost:3000
# Configure securely in environment settings, never in this example:
# RESEND_API_KEY=YOUR_RESEND_API_KEY
# RESEND_FROM=AI Workflow Atlas <newsletter@YOUR_VERIFIED_DOMAIN>
# Test capture is only supported by isolated test runners on a *_test database.
# ATLAS_NEWSLETTER_TEST_CAPTURE is not a production setting.

# Wompi Colombia - Sandbox only, disabled by default.
# Do not enable until official protocol review, test account and HTTPS webhook are ready.
WOMPI_SANDBOX_ENABLED=false
# PAYMENT_ORIGIN=http://localhost:3000
# WOMPI_PUBLIC_KEY=YOUR_PUBLIC_SANDBOX_KEY
# WOMPI_INTEGRITY_SECRET=YOUR_RAW_PRIVATE_SANDBOX_INTEGRITY_SECRET
# WOMPI_EVENTS_SECRET=YOUR_RAW_PRIVATE_SANDBOX_EVENTS_SECRET
# Integrity/events secrets are used locally for hashing: do not use proxy placeholders.
# No production keys, USD conversion or real-charge switches are supported.
# Hosted checkout keeps payment instruments outside this application.

# Agent engine: disabled and zero global spend allowance by default.
AGENTS_ENABLED=false
AGENTS_MONTHLY_BUDGET_USD_MICROS=0
AGENTS_MAX_CONCURRENCY=2
AGENT_ALLOWED_MODELS=gpt-4.1-mini
# Configure the provider credential securely; never paste a real key here.
# ATLAS_OPENAI_API_KEY=YOUR_PRIVATE_OPENAI_API_KEY
# Local non-cloud deployments can also use OPENAI_API_KEY.
# Model tariffs and agent/task limits must be reviewed and set by an operator.
# Dedicated worker startup and scheduler validation: docs/AGENT_ENGINE.md

# Exact trusted source hosts for explicit admin research intake (no search/crawler).
AGENT_RESEARCH_HOSTS=raw.githubusercontent.com
# Each destination must also be allowed by the environment network policy.

# Phase 11: opt-in, first-party analytics. Disabled by default.
ANALYTICS_ENABLED=false
# ANALYTICS_ORIGIN=http://localhost:3000
# GA4 Measurement Protocol stays disabled until credentials and consent are configured.
GA4_MODE=disabled
# GA4_MEASUREMENT_ID=YOUR_PUBLIC_MEASUREMENT_ID
# GA4_API_SECRET=YOUR_PRIVATE_MEASUREMENT_PROTOCOL_SECRET
# GA4_PROPERTY_ID=YOUR_NUMERIC_PROPERTY_ID
# GA4_ACCESS_TOKEN=YOUR_PRIVATE_READONLY_OAUTH_ACCESS_TOKEN
# GSC_SITE_URL=https://YOUR_VERIFIED_SITE/
# GSC_ACCESS_TOKEN=YOUR_PRIVATE_READONLY_OAUTH_ACCESS_TOKEN
# Per-partner local HMAC keys: configure privately, never paste a real value here.
# AFFILIATE_PROVIDER_PARTNER_SECRET=YOUR_PRIVATE_RANDOM_SIGNING_KEY
# Secrets used locally for HMAC/URL fields need compatible raw private configuration.
# Google report OAuth credentials may use supported proxy bindings for the fixed API hosts.

# Phase 12: production preparation only; no deployment or account provisioning.
# Separate direct operator connection for db:deploy / db:status only.
# Runtime always uses DATABASE_URL with a least-privileged role.
# MIGRATION_DATABASE_URL=postgresql://MIGRATOR:PASSWORD@HOST:5432/atlas?sslmode=verify-full
# Explicitly public legal identity/contact, never derived from admin credentials.
# PUBLIC_OPERATOR_NAME=YOUR_REVIEWED_LEGAL_NAME
# PUBLIC_OPERATOR_ADDRESS=YOUR_REVIEWED_BUSINESS_ADDRESS
# PUBLIC_CONTACT_EMAIL=contact@YOUR_VERIFIED_DOMAIN
# LEGAL_EFFECTIVE_DATE=YYYY-MM-DD
LEGAL_REVIEW_CONFIRMED=false
# Private raw random bearer token (at least 32 characters) for readiness monitors.
# OPS_MONITOR_TOKEN=YOUR_PRIVATE_RANDOM_MONITORING_TOKEN
OPS_EXPECT_WORKER=false
# Set true only after verifying the dedicated supervisor and expected worker identity.
OPS_WORKER_ID=docker-local

# Temporary, allowlisted server-side DB failure diagnostics (stage/codes only).
# Set false after investigation; failures still throw and private readiness stays protected.
DATABASE_DIAGNOSTICS_ENABLED=true

# Phase 13: Actions-only catalog importer. Never set a migration/owner URL here.
# Configure CATALOG_DATABASE_URL privately as an Actions secret for the new
# atlas_staging_catalog role; no fallback to Render DATABASE_URL is allowed.
# NEON_STAGING_EXPECTED_HOST is a privately configured Actions variable with the
# independently verified direct staging hostname. See docs/CATALOG_OPERATIONS.md.
