# Example configuration only; never insert real secrets in this file.
# Absolute HTTP(S) origin only: no path, query, fragment or credentials.
# Metadata changes require a new production build.
SITE_URL=http://localhost:3000

# Explicit preview of fictional DRAFT records marked isDemo=true.
# Keep false for a public deployment; it never publishes the development seed.
CATALOG_DEMO_MODE=false

# PostgreSQL: npm run db:local can generate local-only credentials in .env.local.
# For an external database, configure the bindings securely (examples only):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/atlas_dev?sslmode=verify-full
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/atlas_test?sslmode=verify-full
# Tests create and remove their own isolated database; the test role needs CREATEDB.
# DEV_POSTGRES_PASSWORD is generated by the local helper; never commit its value.
# Administration: exact browser origin; HTTPS required except on loopback.
# Defaults to SITE_URL. Set separately when the browser origin differs.
# ADMIN_ORIGIN=http://localhost:3000
# First owner identity for the interactive operator CLI; illustrative address only.
# ADMIN_BOOTSTRAP_EMAIL=owner@example.invalid
# Passwords are entered with npm run admin:init, never configured in this file.
# Payment and AI provider credentials remain outside this phase. Email settings below.

# Keep false during pre-launch. Enabling also requires an explicit HTTPS SITE_URL
# on a non-loopback host and CATALOG_DEMO_MODE=false. No launch is performed here.
SEO_INDEXING_ENABLED=false

# Public sponsorship inquiry signing key, private and shared by app instances.
# Generate local-only configuration with npm run commercial:secret; never paste it here.
# SPONSOR_FORM_SECRET=YOUR_PRIVATE_64_LOWERCASE_HEX_SIGNING_KEY
# Exact browser origin for public inquiry POST; defaults to SITE_URL/localhost:3000.
# SPONSOR_ORIGIN=http://localhost:3000

# Newsletter remains local until Resend is explicitly enabled.
# Generate a private local 32-byte encryption/signing key with npm run newsletter:secret.
# Preserve this key with private database backups; never use a proxy placeholder for it.
# NEWSLETTER_SECRET=YOUR_PRIVATE_64_LOWERCASE_HEX_KEY
NEWSLETTER_MODE=disabled
# Exact public browser origin and email link origin; HTTPS except loopback.
# NEWSLETTER_ORIGIN=http://localhost:3000
# Configure securely in environment settings, never in this example:
# RESEND_API_KEY=YOUR_RESEND_API_KEY
# RESEND_FROM=AI Workflow Atlas <newsletter@YOUR_VERIFIED_DOMAIN>
# Test capture is only supported by isolated test runners on a *_test database.
# ATLAS_NEWSLETTER_TEST_CAPTURE is not a production setting.
